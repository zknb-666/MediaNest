<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/web_nav_selected" />
            <stroke android:color="@color/focus" android:width="2dp" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/web_nav_selected" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/web_card_bg" />
            <stroke android:color="@color/web_divider" android:width="1dp" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
